        "https://raw.githubusercontent.com/KittenUzuki/Webot-SeguidorDeLinha/main/SeguidorDeLinha_Webots/worlds/textures/pista_textura.png"
      ]
      repeatS FALSE
      repeatT FALSE
    }
    roughness 1
    metalness 0
  }
  wallHeight 0.05
}
