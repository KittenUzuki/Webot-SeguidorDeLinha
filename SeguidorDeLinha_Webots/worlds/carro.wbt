  }Robot {
  translation -0.5 -0.5 0.001
  rotation 0 0 1 0
  # ---------------------------------------------------------
  # Projeto: Seguidor de Linha - Simulacao Webots
  # Aluno: Matheus Ferreira Fagundes   RA: 23149
  # Disciplina/Turma: <PREENCHER>
  # Baseado no modelo de carro fornecido em sala (Robo_Webot_base1 / Robo - Sensor)
  # IMPORTANTE: a estrutura das rodas/juntas abaixo foi mantida EXATAMENTE
  # igual ao arquivo original do professor (testado em sala), para garantir
  # estabilidade fisica. Apenas cores, sensores e o corpo foram alterados.
  # ---------------------------------------------------------
  children [
    Pose {
      children [
        # ---------- Roda esquerda (motorE) - identica ao original ----------
        HingeJoint {
          jointParameters HingeJointParameters {
            position 0
            axis 0 1 0
            anchor 0 0 0.025
          }
          device [
            RotationalMotor {
              name "motorE"
              consumptionFactor 70
              maxVelocity 100
            }
          ]
          endPoint Solid {
            translation 0 0 0
            rotation 0 1 0 0
            children [
              DEF RodaE Pose {
                translation 0 0.055 0.025
                rotation 1 0 0 1.5707996938995747
                children [
                  Shape {
                    appearance PBRAppearance {
                      baseColor 0.1 0.1 0.1
                      roughness 1
                      metalness 0
                    }
                    geometry Cylinder {
                      height 0.01
                      radius 0.025
                    }
                  }
                ]
              }
            ]
            boundingObject USE RodaE
            physics Physics {
              mass 0.05
            }
          }
        }
        # ---------- Roda direita (motorD) - identica ao original ----------
        HingeJoint {
          jointParameters HingeJointParameters {
            position 0
            axis 0 1 0
            anchor 0 0 0.025
          }
          device [
            RotationalMotor {
              name "motorD"
              consumptionFactor 70
              maxVelocity 100
            }
          ]
          endPoint Solid {
            translation 0 0 0
            rotation 0 1 0 0
            children [
              DEF RodaD Pose {
                translation 0 -0.055 0.025
                rotation 1 0 0 1.5707996938995747
                children [
                  Shape {
                    appearance PBRAppearance {
                      baseColor 0.1 0.1 0.1
                      roughness 1
                      metalness 0
                    }
                    geometry Cylinder {
                      height 0.01
                      radius 0.025
                    }
                  }
                ]
              }
            ]
            name "solid(1)"
            boundingObject USE RodaD
            physics Physics {
              density -1
              mass 0.05
            }
          }
        }
        # ---------- Chassi (novo design: corpo azul + "nariz" laranja) ----------
        Pose {
          translation 0 0 0.07
          children [
            Shape {
              appearance PBRAppearance {
                baseColor 0.1 0.35 0.85
                roughness 0.6
                metalness 0.1
              }
              geometry Box {
                size 0.1 0.09 0.05
              }
            }
          ]
        }
        Pose {
          translation 0.07 0 0.065
          rotation 0 1 0 1.5708
          children [
            Shape {
              appearance PBRAppearance {
                baseColor 1 0.55 0.1
                roughness 0.5
                metalness 0.1
              }
              geometry Cone {
                bottomRadius 0.03
                height 0.05
              }
            }
          ]
        }
        # ---------- Sensores infravermelhos de linha (apontados para o chao) ----------
        # Os tres sensores ficam na frente do robo, olhando para baixo (eixo local
        # +x do sensor e' rotacionado 90 graus em torno de Y, apontando para -Z).
        # Estes sensores NAO tem boundingObject/physics proprios, entao nao afetam
        # a estabilidade fisica do robo (sao apenas visuais + raio de deteccao).
        # ESQUERDO
        Pose {
          translation 0.06 0.02 0.02
          children [
            DistanceSensor {
              rotation 0 1 0 1.5708
              children [
                Shape {
                  appearance PBRAppearance {
                    baseColor 0.8 0.1 0.1
                    roughness 1
                    metalness 0
                  }
                  geometry Cylinder {
                    height 0.006
                    radius 0.006
                  }
                }
              ]
              name "ds_esquerda"
              lookupTable [
                0 0 0
                0.1 10 0
              ]
              type "infra-red"
              redColorSensitivity 0.5
            }
          ]
        }
        # CENTRAL
        Pose {
          translation 0.06 0 0.02
          children [
            DistanceSensor {
              rotation 0 1 0 1.5708
              children [
                Shape {
                  appearance PBRAppearance {
                    baseColor 0.1 0.8 0.1
                    roughness 1
                    metalness 0
                  }
                  geometry Cylinder {
                    height 0.006
                    radius 0.006
                  }
                }
              ]
              name "ds_centro"
              lookupTable [
                0 0 0
                0.1 10 0
              ]
              type "infra-red"
              redColorSensitivity 0.5
            }
          ]
        }
        # DIREITO
