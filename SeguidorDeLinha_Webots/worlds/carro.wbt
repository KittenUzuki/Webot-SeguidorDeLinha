        "textures/pista_textura.png"
        "<COLOQUE_AQUI_O_LINK_RAW_GITHUB_DA_SUA_IMAGEM_DE_PISTA>"
      ]
      repeatS FALSE
      repeatT FALSE
    }
    roughness 1
    metalness 0
  }
  wallHeight 0.05
}
